{
  "name": "@notatio/ce-patches",
  "version": "0.0.0",
  "private": true,
  "description": "Heads and fixes compute-engine would plausibly take, applied as patches until it ships them: kept apart from what is ours, so landing upstream is a deletion, not an excavation.",
  "license": "WTFPL",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./glsl-complex": {
      "types": "./dist/glsl-complex.d.mts",
      "import": "./dist/glsl-complex.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/generate-patches.ts && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@notatio/engine": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.187.1",
    "@notatio/config": "workspace:*",
    "@notatio/engine": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.187.1"
  },
  "enumeratio": {
    "site": "enumeratio",
    "layer": "infra",
    "extends": [],
    "reads": [
      "../reference/golden/upstream"
    ]
  },
  "generated": [
    "src/patches/registry-data.ts"
  ]
}
