{
  "name": "@notatio/oracle",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-check the reference catalogue against external systems: signature-level mappings, emitters, batch runners, and the blessed values a scan produces.",
  "license": "WTFPL",
  "files": [
    "dist",
    "kernels.json",
    "julia",
    "lean",
    "oscar",
    "python",
    "rust"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./kernels.json": "./kernels.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../reference/scripts/collect-mappings.ts && node ../reference/scripts/collect-defined-names.ts && node ../reference/scripts/collect-carrier-names.ts && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@notatio/utils": "workspace:*",
    "@notatio/wolfram": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.187.1",
    "@notatio/adeles": "workspace:*",
    "@notatio/analytic": "workspace:*",
    "@notatio/boxes": "workspace:*",
    "@notatio/braid": "workspace:*",
    "@notatio/ce-patches": "workspace:*",
    "@notatio/combinatorics": "workspace:*",
    "@notatio/config": "workspace:*",
    "@notatio/diagram": "workspace:*",
    "@notatio/engine": "workspace:*",
    "@notatio/entry": "workspace:*",
    "@notatio/evaluation": "workspace:*",
    "@notatio/formats": "workspace:*",
    "@notatio/geometric": "workspace:*",
    "@notatio/groupalgebra": "workspace:*",
    "@notatio/hecke": "workspace:*",
    "@notatio/hopf": "workspace:*",
    "@notatio/hypercomplex": "workspace:*",
    "@notatio/incidence": "workspace:*",
    "@notatio/manifest": "workspace:*",
    "@notatio/modular": "workspace:*",
    "@notatio/number-theory": "workspace:*",
    "@notatio/numerals": "workspace:*",
    "@notatio/plausible": "workspace:*",
    "@notatio/quiver": "workspace:*",
    "@notatio/residues": "workspace:*",
    "@notatio/structures": "workspace:*",
    "@types/node": "^24",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "enumeratio": {
    "site": "enumeratio",
    "layer": "tooling",
    "extends": [],
    "reads": [
      "@records"
    ]
  },
  "generated": [
    "src/mappings-data.ts",
    "src/defined-names-data.ts",
    "src/carrier-names-data.ts"
  ]
}
