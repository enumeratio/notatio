{
  "name": "@notatio/reference",
  "version": "0.0.0",
  "private": true,
  "description": "Structured, verified example data for compute-engine functions — the single source for reference pages and their tests.",
  "license": "WTFPL",
  "files": [
    "dist",
    "entries"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/collect-catalog-references.ts && node scripts/collect-curated.ts && node scripts/collect-oracle-agreements.ts && node scripts/collect-crosswalk.ts && node scripts/collect-provenance.ts && node scripts/oracle-scan.ts --digest && vp pack",
    "test": "vp test",
    "check": "vp check",
    "crosswalk:collect": "node scripts/collect-crosswalk.ts",
    "crosswalk:fetch": "node scripts/collect-crosswalk.ts && node scripts/fetch-fungrim-symbols.ts && node scripts/fetch-inventories.ts && node scripts/fetch-wikidata.ts && node scripts/fetch-dlmf.ts",
    "crosswalk:find": "node scripts/find-oeis.ts && node scripts/find-findstat.ts",
    "crosswalk:check": "node scripts/collect-crosswalk.ts && node scripts/check-crosswalk.ts",
    "crosswalk:verify": "node scripts/verify-fungrim.ts",
    "crosswalk:audit": "node scripts/collect-crosswalk.ts && node scripts/audit-wikidata.ts"
  },
  "dependencies": {
    "@notatio/catalog": "workspace:*",
    "@notatio/combinatorics": "workspace:*",
    "@notatio/entry": "workspace:*",
    "@notatio/oracle": "workspace:*",
    "@notatio/utils": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.189.0",
    "@notatio/adeles": "workspace:*",
    "@notatio/analytic": "workspace:*",
    "@notatio/boxes": "workspace:*",
    "@notatio/braid": "workspace:*",
    "@notatio/ce-patches": "workspace:*",
    "@notatio/config": "workspace:*",
    "@notatio/diagram": "workspace:*",
    "@notatio/engine": "workspace:*",
    "@notatio/evaluation": "workspace:*",
    "@notatio/formats": "workspace:*",
    "@notatio/geometric": "workspace:*",
    "@notatio/groupalgebra": "workspace:*",
    "@notatio/hecke": "workspace:*",
    "@notatio/hopf": "workspace:*",
    "@notatio/hypercomplex": "workspace:*",
    "@notatio/incidence": "workspace:*",
    "@notatio/manifest": "workspace:*",
    "@notatio/modular": "workspace:*",
    "@notatio/number-theory": "workspace:*",
    "@notatio/numerals": "workspace:*",
    "@notatio/plausible": "workspace:*",
    "@notatio/quiver": "workspace:*",
    "@notatio/residues": "workspace:*",
    "@notatio/statistics": "workspace:*",
    "@notatio/structures": "workspace:*",
    "@notatio/wolfram": "workspace:*",
    "@types/node": "^24",
    "ts-morph": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.189.0"
  },
  "enumeratio": {
    "site": "enumeratio",
    "layer": "tooling",
    "extends": [],
    "reads": [
      "@records"
    ]
  },
  "generated": [
    "src/crosswalk/catalog-references-data.ts",
    "src/crosswalk/curated-data.ts",
    "src/crosswalk/oracle-agreements-data.ts",
    "src/crosswalk-data.ts",
    "src/engine-symbols-data.ts",
    "src/provenance-data.ts"
  ]
}
