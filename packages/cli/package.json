{
  "name": "@notatio/cli",
  "version": "0.0.0",
  "private": true,
  "description": "notatio on the command line: a Wolfram-style REPL and one-shot evaluator for compute-engine with the enumeratio symbols declared.",
  "license": "WTFPL",
  "bin": {
    "notatio": "./bin/notatio.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./browser": "./dist/browser.mjs",
    "./command": "./dist/command.mjs",
    "./completion": "./dist/completion.mjs",
    "./engine": "./dist/engine.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/browser.ts src/command.ts src/completion.ts src/engine.ts",
    "dev": "vp pack src/index.ts src/browser.ts src/command.ts src/completion.ts src/engine.ts --watch",
    "start": "tsx src/main.ts",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.187.1",
    "@notatio/analytic": "workspace:*",
    "@notatio/boxes": "workspace:*",
    "@notatio/braid": "workspace:*",
    "@notatio/combinatorics": "workspace:*",
    "@notatio/diagram": "workspace:*",
    "@notatio/engine": "workspace:*",
    "@notatio/evaluation": "workspace:*",
    "@notatio/formats": "workspace:*",
    "@notatio/frontend": "workspace:*",
    "@notatio/groupalgebra": "workspace:*",
    "@notatio/hecke": "workspace:*",
    "@notatio/hopf": "workspace:*",
    "@notatio/hypercomplex": "workspace:*",
    "@notatio/incidence": "workspace:*",
    "@notatio/manifest": "workspace:*",
    "@notatio/modular": "workspace:*",
    "@notatio/number-theory": "workspace:*",
    "@notatio/numerals": "workspace:*",
    "@notatio/quiver": "workspace:*",
    "@notatio/raster": "workspace:*",
    "@notatio/residues": "workspace:*",
    "@notatio/statistics": "workspace:*",
    "@notatio/structures": "workspace:*"
  },
  "devDependencies": {
    "@notatio/config": "workspace:*",
    "@types/node": "^24",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "enumeratio": {
    "site": "notatio",
    "layer": "presentation",
    "extends": []
  }
}
