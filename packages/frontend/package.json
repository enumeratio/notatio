{
  "name": "@notatio/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "The base of the interface: the symbol-to-component map and its lowering, the AST as a vdom, the control contract, the arithmetic of scrubbing and playback, the pure SVG renderers. No UI framework.",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./box-tags": "./dist/box-tags.mjs",
    "./conventional-latex": "./dist/conventional-latex.mjs",
    "./core": "./dist/core.mjs",
    "./declare-carriers": "./dist/declare-carriers.mjs",
    "./display": "./dist/display.mjs",
    "./explorer": "./dist/explorer.mjs",
    "./explorer-engine": "./dist/explorer-engine.mjs",
    "./function-view": "./dist/function-view.mjs",
    "./kernel-host": "./dist/kernel-host.mjs",
    "./plot-compile": "./dist/plot-compile.mjs",
    "./prerender": "./dist/prerender.mjs",
    "./reflect": "./dist/reflect.mjs",
    "./row-source": "./dist/row-source.mjs",
    "./symbols": "./dist/symbols.mjs",
    "./vdom": "./dist/vdom.mjs",
    "./package.json": "./package.json",
    "./declares.json": "./dist/declares.json"
  },
  "scripts": {
    "build": "node scripts/build-glyphs.ts && node scripts/build-carrier-statistics.ts && vp pack src/index.ts src/core.ts src/symbols.ts src/vdom.ts src/reflect.ts src/conventional-latex.ts src/declare-carriers.ts src/display.ts src/explorer.ts src/explorer-engine.ts src/function-view.ts src/kernel-host.ts src/plot-compile.ts src/prerender.ts src/box-tags.ts src/row-source.ts && node scripts/build-forms.ts && enumeratio-collect-declares .",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@notatio/analytic": "workspace:*",
    "@notatio/boxes": "workspace:*",
    "@notatio/braid": "workspace:*",
    "@notatio/ce-patches": "workspace:*",
    "@notatio/complex-numerals": "workspace:*",
    "@notatio/engine": "workspace:*",
    "@notatio/evaluation": "workspace:*",
    "@notatio/formats": "workspace:*",
    "@notatio/manifest": "workspace:*",
    "@notatio/number-theory": "workspace:*",
    "@notatio/polytope": "workspace:*",
    "@notatio/residues": "workspace:*",
    "@notatio/structures": "workspace:*",
    "d3-scale-chromatic": "catalog:"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.187.1",
    "@notatio/combinatorics": "workspace:*",
    "@notatio/config": "workspace:*",
    "@notatio/entry": "workspace:*",
    "@notatio/oracle": "workspace:*",
    "@notatio/reference": "workspace:*",
    "@notatio/wolfram": "workspace:*",
    "@types/d3-scale-chromatic": "catalog:",
    "@types/node": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.187.1"
  },
  "enumeratio": {
    "layer": "presentation",
    "extends": [
      "structures"
    ],
    "late": "./declare-carriers#declareFrontendCarriers",
    "reads": [
      "@records"
    ],
    "declares": "./declares.json"
  },
  "generated": [
    "generated/forms.json",
    "generated/carrier-statistics.json",
    "generated/head-glyphs.json"
  ]
}
