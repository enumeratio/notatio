{
  "name": "@notatio/components",
  "version": "0.0.0",
  "private": true,
  "description": "The notatio-* custom elements (Lit): every symbol that draws or controls, built on @notatio/frontend.",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./lazy": "./dist/lazy.mjs",
    "./stories-data": "./dist/stories-data.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/collect-stories.ts && vp pack src/index.ts src/lazy.ts src/stories-data.ts",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@notatio/analytic": "workspace:*",
    "@notatio/boxes": "workspace:*",
    "@notatio/ce-patches": "workspace:*",
    "@notatio/cli": "workspace:*",
    "@notatio/complex-numerals": "workspace:*",
    "@notatio/engine": "workspace:*",
    "@notatio/evaluation": "workspace:*",
    "@notatio/formats": "workspace:*",
    "@notatio/frontend": "workspace:*",
    "@notatio/number-theory": "workspace:*",
    "@notatio/polytope": "workspace:*",
    "@notatio/residues": "workspace:*",
    "@notatio/structures": "workspace:*",
    "@notatio/wolfram": "workspace:*",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "katex": "catalog:",
    "lit": "^3.3.3",
    "mathlive": "^0.110.0"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.187.1",
    "@notatio/combinatorics": "workspace:*",
    "@notatio/config": "workspace:*",
    "@notatio/entry": "workspace:*",
    "happy-dom": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.187.1"
  },
  "enumeratio": {
    "layer": "presentation",
    "extends": [],
    "reads": [
      "@sources"
    ]
  },
  "generated": [
    "src/stories-data.ts"
  ]
}
