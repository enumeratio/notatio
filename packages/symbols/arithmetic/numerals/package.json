{
  "name": "@notatio/numerals",
  "version": "0.0.0",
  "private": true,
  "description": "Numeral-system extensions for @cortex-js/compute-engine: IntegerDigits/FromDigits over radix, mixed-radix, factoradic, balanced, negative, bijective, Zeckendorf, combinatorial and residue systems.",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./notation": {
      "types": "./dist/notation.d.mts",
      "import": "./dist/notation.mjs"
    },
    "./declares.json": "./dist/declares.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && enumeratio-collect-declares .",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@notatio/boxes": "workspace:*",
    "@notatio/engine": "workspace:*",
    "@notatio/residues": "workspace:*",
    "@notatio/structures": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.187.1",
    "@notatio/config": "workspace:*",
    "@notatio/engine": "workspace:*",
    "@notatio/manifest": "workspace:*",
    "@notatio/residues": "workspace:*",
    "@notatio/utils": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.187.1"
  },
  "enumeratio": {
    "layer": "extension",
    "area": "arithmetic",
    "extends": [
      "residues"
    ],
    "notation": "./notation",
    "group": "arithmetic",
    "declare": "declareNumerals",
    "declares": "./declares.json"
  }
}
