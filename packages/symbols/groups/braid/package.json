{
  "name": "@notatio/braid",
  "version": "0.0.0",
  "private": true,
  "description": "Braid groups for @cortex-js/compute-engine: the Artin presentation, positive braids and their closures, the Burau representation, Alexander polynomials, torus knots, and the Lorenz braids of modular geodesics.",
  "license": "WTFPL",
  "files": [
    "dist",
    "reference",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./notation": {
      "types": "./dist/notation.d.mts",
      "import": "./dist/notation.mjs"
    },
    "./words": {
      "types": "./dist/words.d.mts",
      "import": "./dist/words.mjs"
    },
    "./declares.json": "./dist/declares.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "enumeratio-collect-notation . && vp pack && enumeratio-collect-declares .",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@notatio/boxes": "workspace:*",
    "@notatio/diagram": "workspace:*",
    "@notatio/engine": "workspace:*",
    "@notatio/structures": "workspace:*"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.187.1",
    "@notatio/config": "workspace:*",
    "@notatio/diagram": "workspace:*",
    "@notatio/engine": "workspace:*",
    "@notatio/manifest": "workspace:*",
    "@notatio/modular": "workspace:*",
    "@notatio/structures": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.187.1"
  },
  "enumeratio": {
    "layer": "extension",
    "extends": [
      "structures",
      "diagram"
    ],
    "notation": "./notation",
    "group": "groups",
    "declare": "declareBraid",
    "declares": "./declares.json"
  },
  "generated": [
    "src/notation.generated.ts"
  ]
}
